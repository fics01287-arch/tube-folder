{
  "name": "tubefolder-extension-v2",
  "version": "0.1.0",
  "private": true,
  "description": "튜브폴더 v2 — React + TypeScript + Vite 기반 MV3 크롬 확장",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:manager": "vite build",
    "build:background": "vite build --config vite.background.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "check:fingerprint": "node scripts/check-fingerprint.mjs",
    "check:fingerprint:dist": "node scripts/check-fingerprint.mjs --dist dist:2",
    "notices": "node scripts/make-notices.mjs",
    "check:notices": "node scripts/make-notices.mjs --check",
    "check:notices:dist": "node scripts/make-notices.mjs --check --dist dist:manager,background,content",
    "check:notices:pwa": "node scripts/make-notices.mjs --check --dist pwa-dist:pwa",
    "build": "npm run check:fingerprint && npm run check:notices && npm run typecheck && npm run build:manager && npm run build:background && npm run build:content && npm run check:fingerprint:dist && npm run check:notices:dist",
    "build:pwa": "npm run check:fingerprint && npm run check:notices && npm run typecheck && vite build --config vite.pwa.config.ts && node scripts/rename-pwa-entry.mjs && node scripts/check-fingerprint.mjs --dist pwa-dist:1 && npm run check:notices:pwa",
    "package": "npm run build && powershell -NoProfile -Command \"Compress-Archive -Path dist/* -DestinationPath ../tubefolder-extension-v2.zip -Force\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.14.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
